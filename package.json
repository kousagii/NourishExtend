{
  "name": "nourish-extend",
  "version": "1.1.0",
  "license": "0BSD",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --max-workers 2 && node scripts/finish-export.cjs",
    "test": "node --test tests/*.test.cjs",
    "export:android": "expo export --platform android --output-dir exports/android-bundle --max-workers 2",
    "build:apk": "node scripts/build-android.cjs",
    "configure": "node scripts/configure.cjs",
    "preexport:web": "node scripts/check-config.cjs",
    "preexport:android": "node scripts/check-config.cjs",
    "prebuild:apk": "node scripts/check-config.cjs",
    "preview": "node scripts/preview.cjs",
    "test:server": "npx --yes --package=deno@2.5.6 deno test --allow-net=deno.land supabase/functions/_shared/process-image_test.ts",
    "android:setup": "node scripts/setup-android.cjs",
    "android:development": "expo run:android",
    "package": "python scripts/package.py",
    "check:backend": "node scripts/check-backend.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/libre-franklin": "0.4.2",
    "@expo/metro-runtime": "58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/stack": "7.12.1",
    "@supabase/supabase-js": "2.118.0",
    "expo": "58.0.22",
    "expo-font": "58.0.11",
    "expo-image-picker": "58.0.10",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@electric-sql/pglite": "0.5.14",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
