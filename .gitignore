# Installed dependencies and regenerable caches
node_modules/
.expo/
.cache/
.npm/
*.tsbuildinfo
.eslintcache
.stylelintcache
.metro-health-check*

# Build exports, test output and local-only tooling
/dist/
/exports/
/test-results/
/coverage/
/.test-data/
/.tools/
/.local/
/.review/

# Private configuration; keep the secret-free setup template for fresh checkouts
.env
.env.*
.envrc
!/.env.example

# Signing keys and local credentials
*.jks
*.keystore
*.p12
*.pfx
*.key
credentials.json
demo-signing.properties

# Android source, Gradle wrapper and resources stay in Git for local APK builds
/android/local.properties
/android/.gradle/
/android/.kotlin/
/android/**/build/
/android/**/.cxx/
/android/**/.externalNativeBuild/
*.iml
*.hprof
*.apk
*.aab
*.apks

# Generated Supabase CLI state; retain migrations, functions and email templates
/supabase/.temp/
/supabase/.branches/

# Local project notes; only the brief root README is published
*.md
!/README.md
/docs/
/legacy/

# Unused starter component and prototype-only images
/AssetExample.js
/finalbg.png
/Images/finalbg.png
/Images/snack-icon.png
/Images/donate.jfif
/Images/notification.png
/Images/truck.png

