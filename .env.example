# Public client configuration; never put a service_role key or database password here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Deployed web URL for verification and password-reset redirects.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
# Supply approved operator/contact/retention text before launch.
EXPO_PUBLIC_PRIVACY_OPERATOR=NourishExtend student project team
EXPO_PUBLIC_PRIVACY_EMAIL=nourishextend@gmail.com
# Set true only after the maintenance job is deployed, scheduled and verified.
EXPO_PUBLIC_RETENTION_ENABLED=false
